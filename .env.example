# GraphHarvester — .env.example
# Copy to .env and fill in your values.
# Lines with inline comments: dotenv ignores text after '#'.

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Groq ──────────────────────────────────────────────────────────────────────
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=

# ── LLM Providers (fallback order: Gemini → Groq → OpenRouter → DeepSeek) ────
# Gemini: https://aistudio.google.com/apikey  (key starts with AQ. or AIza)
GEMINI_API_KEY=
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Auth method: "oauth" (default, uses browser on first run) | "service_account"
GOOGLE_AUTH_METHOD=oauth
GOOGLE_CREDENTIALS_JSON=credentials/google_client_secret.json
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
GOOGLE_TOKEN_FILE=credentials/token.json
# Sheet ID is the long string in your Sheet URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=

# ── External APIs ─────────────────────────────────────────────────────────────
# GitHub: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=
# OpenAlex polite pool — just your email, no signup needed (10 req/s vs 1 req/s)
OPENALEX_EMAIL=
# Product Hunt: https://api.producthunt.com/v2/oauth/applications (optional)
PRODUCT_HUNT_TOKEN=

# ── Neo4j (optional graph DB) ─────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ── Scraping ──────────────────────────────────────────────────────────────────
DEFAULT_SEMAPHORE=10
REQUEST_TIMEOUT=30
ARXIV_QUERY=artificial intelligence
ARXIV_MAX_RESULTS=1000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
